FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    zlib1g \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Placement of compiled aarch64 binary
COPY target/aarch64-unknown-linux-gnu/release/utopia-server /usr/local/bin/utopia-server

# Copy web dist
COPY web/dist /app/web-dist

# Create non-root user
RUN useradd -u 10001 -U -s /bin/sh utopia && \
    mkdir -p /app/data && \
    chown -R utopia:utopia /app

USER utopia

ENV UTOPIA_WEB_DIST=/app/web-dist \
    UTOPIA_DATA_DIR=/app/data \
    UTOPIA_BIND_ADDR=0.0.0.0:1516 \
    RUST_LOG=info

EXPOSE 1516

ENTRYPOINT ["utopia-server"]
